# ============================================================
# Valores para TESTE LOCAL (copie para ".env" e rode "npm start").
# Em produção no Coolify, NÃO suba um .env — defina estas mesmas
# variáveis em "Environment Variables" do serviço, com os valores
# de produção indicados nos comentários abaixo.
# ============================================================

# Porta em que o Node escuta localmente.
# No Coolify não defina esta variável: ele injeta PORT sozinho.
PORT=3000

# "development" (padrão aqui) permite login em http://localhost sem HTTPS.
# Em produção, defina NODE_ENV=production no Coolify — isso ativa
# cookie Secure (exige HTTPS) e HSTS. Se você colocar "production"
# aqui e testar em localhost sem HTTPS, o login do painel não vai
# funcionar (o navegador descarta o cookie).
NODE_ENV=development

# Segredo para assinar o cookie de sessão (JWT). OBRIGATÓRIO.
# Gere um valor com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use um valor diferente (e mais forte) em produção — nunca reaproveite
# o que você gerar aqui para testar localmente.
JWT_SECRET=8a146cc3308cebb4c1f5cff43926cd5b48c00c7dc9102e5b741ede762e5094af

# Administrador do painel. A cada boot o servidor garante (sem duplicar) que
# este usuário exista e que a senha confira com ADMIN_PASSWORD.
# Valores abaixo = CREDENCIAL FIXA DE DEMONSTRAÇÃO. Antes de publicar em
# produção, troque por uma senha forte (e, depois de trocar a senha pelo
# painel, defina ADMIN_ENFORCE_PASSWORD=false para ela não ser revertida).
ADMIN_EMAIL=admin@almeidaleal.adv.br
ADMIN_PASSWORD=AlmeidaDemo2026!

# Onde ficam os dados (banco em JSON + imagens enviadas pelo painel).
# Aqui local: uma pasta "data" dentro do próprio projeto.
# No Coolify, use DATA_DIR=/app/data e aponte um Volume persistente
# para esse caminho — sem isso, tudo se perde a cada novo deploy.
DATA_DIR=./data
